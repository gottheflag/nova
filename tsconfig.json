{
	"compilerOptions": {
		"target": "es2022",

		"module": "NodeNext",
		"moduleResolution": "NodeNext",

		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		
		"outDir": "./dist",
		"rootDir": "./src",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}